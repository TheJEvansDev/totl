# Copy this file to .env.local for local development.
# On Vercel, add these under Project > Settings > Environment Variables.
# Leave a value blank and the app uses sample data for that part.

# Flights: live Google Flights prices via SerpApi (serpapi.com > Dashboard > API key)
SERPAPI_KEY=

# Accommodation: LiteAPI key (sandbox or live)
LITEAPI_KEY=

# Feedback: optional Discord/Slack-style webhook URL that receives tester feedback
FEEDBACK_WEBHOOK_URL=

# "Describe your trip" box: Anthropic API key (console.anthropic.com > API keys).
# Leave blank to hide the box.
ANTHROPIC_API_KEY=
